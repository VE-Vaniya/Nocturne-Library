# Files consumed inside Linux containers must keep LF endings on Windows checkouts.
Dockerfile        text eol=lf
*.Dockerfile      text eol=lf
.dockerignore     text eol=lf
docker-compose*.yml text eol=lf
nginx/**          text eol=lf
*.env             text eol=lf
.env.example      text eol=lf
*.sh              text eol=lf
