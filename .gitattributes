# Keep LF everywhere so `prettier --check` (endOfLine: lf) gives the same
# result on Windows checkouts as in CI.
* text=auto eol=lf

# Files consumed inside Linux containers must keep LF endings on Windows checkouts.
Dockerfile        text eol=lf
*.Dockerfile      text eol=lf
.dockerignore     text eol=lf
docker-compose*.yml text eol=lf
nginx/**          text eol=lf
*.env             text eol=lf
.env.example      text eol=lf
*.sh              text eol=lf
