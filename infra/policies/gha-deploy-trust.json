{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "GitHubActionsProductionEnvironmentOnly",
      "Effect": "Allow",
      "Principal": {
        "Federated": "arn:aws:iam::__ACCOUNT_ID__:oidc-provider/__OIDC_HOST__"
      },
      "Action": "sts:AssumeRoleWithWebIdentity",
      "Condition": {
        "StringEquals": {
          "__OIDC_HOST__:aud": "sts.amazonaws.com",
          "__OIDC_HOST__:sub": "__GITHUB_DEPLOY_SUB__"
        }
      }
    }
  ]
}
