# shellcheck shell=bash
# Nocturne Library - non-secret infrastructure defaults (sourced by infra/*.sh).
#
# Every value can be overridden from the environment, e.g.
#   INSTANCE_TYPE=t3.small ./infra/50-compute.sh
# NOTHING SECRET GOES IN THIS FILE. Secrets live in SSM Parameter Store under
# ${SSM_PREFIX}/ and are entered interactively (or via env) by 00-bootstrap.sh.
# Design reference: docs/ARCHITECTURE.md.

# ---- identity / region ------------------------------------------------------
PROJECT="${PROJECT:-nocturne}"
ENV_NAME="${ENV_NAME:-prod}"
AWS_REGION="${AWS_REGION:-ap-south-1}"
AZ_A="${AZ_A:-ap-south-1a}"
AZ_B="${AZ_B:-ap-south-1b}"

# ---- network (docs/ARCHITECTURE.md section 2) -------------------------------
VPC_NAME="${VPC_NAME:-nocturne-vpc}"
VPC_CIDR="${VPC_CIDR:-10.20.0.0/16}"
PUBLIC_A_CIDR="${PUBLIC_A_CIDR:-10.20.0.0/24}"
PUBLIC_B_CIDR="${PUBLIC_B_CIDR:-10.20.1.0/24}"
PRIVATE_A_CIDR="${PRIVATE_A_CIDR:-10.20.10.0/24}"
PRIVATE_B_CIDR="${PRIVATE_B_CIDR:-10.20.11.0/24}"
IGW_NAME="${IGW_NAME:-nocturne-igw}"
NAT_NAME="${NAT_NAME:-nocturne-nat-a}"
NAT_EIP_NAME="${NAT_EIP_NAME:-nocturne-nat-a-eip}"
RT_PUBLIC_NAME="${RT_PUBLIC_NAME:-nocturne-rt-public}"
RT_PRIVATE_A_NAME="${RT_PRIVATE_A_NAME:-nocturne-rt-private-a}"
RT_PRIVATE_B_NAME="${RT_PRIVATE_B_NAME:-nocturne-rt-private-b}"
S3_ENDPOINT_NAME="${S3_ENDPOINT_NAME:-nocturne-vpce-s3}"

# ---- security groups (section 4) --------------------------------------------
SG_ALB_NAME="${SG_ALB_NAME:-nocturne-sg-alb}"
SG_APP_NAME="${SG_APP_NAME:-nocturne-sg-app}"

# ---- container registry -----------------------------------------------------
# Must match the image names in docker-compose.prod.yml.
ECR_REPO_FRONTEND="${ECR_REPO_FRONTEND:-nocturne-frontend}"
ECR_REPO_BACKEND="${ECR_REPO_BACKEND:-nocturne-backend}"
# Lifecycle (infra/policies/ecr-lifecycle.json): untagged expire after 3 days,
# keep the newest 20 images per repo (enough history for rollbacks).

# ---- SSM Parameter Store (section 6) ----------------------------------------
SSM_PREFIX="${SSM_PREFIX:-/nocturne/prod}"
SSM_IMAGE_TAG_PARAM="${SSM_IMAGE_TAG_PARAM:-${SSM_PREFIX}/image_tag}"
SSM_PREVIOUS_TAG_PARAM="${SSM_PREVIOUS_TAG_PARAM:-${SSM_PREFIX}/previous_image_tag}"
IMAGE_TAG_PLACEHOLDER="${IMAGE_TAG_PLACEHOLDER:-unset}"
# Env var names the backend container reads (docker-compose.prod.yml).
# Stored as ${SSM_PREFIX}/<NAME>; SecureString unless listed in SSM_PLAIN_KEYS.
SSM_REQUIRED_KEYS="${SSM_REQUIRED_KEYS:-MONGODB_URI JWT_SECRET}"
SSM_OPTIONAL_KEYS="${SSM_OPTIONAL_KEYS:-EMAIL_USER EMAIL_PASS GOOGLE_BOOKS_API_KEY}"
SSM_PLAIN_KEYS="${SSM_PLAIN_KEYS:-CORS_ORIGINS}"   # written by 40-alb.sh

# ---- S3 (config + backups) ---------------------------------------------------
# Bucket names get "-<account-id>-<region>" appended to be globally unique.
CONFIG_BUCKET_PREFIX="${CONFIG_BUCKET_PREFIX:-nocturne-config}"
BACKUP_BUCKET_PREFIX="${BACKUP_BUCKET_PREFIX:-nocturne-backups}"
BACKUP_RETENTION_DAYS="${BACKUP_RETENTION_DAYS:-30}"

# ---- alerts / budget ---------------------------------------------------------
SNS_TOPIC_NAME="${SNS_TOPIC_NAME:-nocturne-alerts}"
BUDGET_NAME="${BUDGET_NAME:-nocturne-monthly}"
BUDGET_LIMIT_USD="${BUDGET_LIMIT_USD:-60}"
BUDGET_ALERT_PERCENTS="${BUDGET_ALERT_PERCENTS:-50 80 100}"   # 30/48/60 USD actual

# ---- IAM / GitHub OIDC (section 5) -------------------------------------------
GITHUB_REPO="${GITHUB_REPO:-VE-Vaniya/Nocturne-Library}"
GITHUB_DEPLOY_ENVIRONMENT="${GITHUB_DEPLOY_ENVIRONMENT:-production}"
# The CD job declares `environment: production`, so GitHub's OIDC token carries
#   sub = repo:<owner>/<repo>:environment:production
# (the environment's deployment branches are restricted to main in GitHub).
# Without an environment it would be repo:<owner>/<repo>:ref:refs/heads/main.
GITHUB_DEPLOY_SUB="${GITHUB_DEPLOY_SUB:-repo:${GITHUB_REPO}:environment:${GITHUB_DEPLOY_ENVIRONMENT}}"
OIDC_HOST="${OIDC_HOST:-token.actions.githubusercontent.com}"
ROLE_CI="${ROLE_CI:-gha-ci}"
ROLE_DEPLOY="${ROLE_DEPLOY:-gha-deploy}"
ROLE_EC2="${ROLE_EC2:-nocturne-ec2}"
INSTANCE_PROFILE="${INSTANCE_PROFILE:-nocturne-ec2}"

# ---- load balancer (section 3) ------------------------------------------------
ALB_NAME="${ALB_NAME:-nocturne-alb}"
TG_WEB_NAME="${TG_WEB_NAME:-nocturne-tg-web}"
TG_API_NAME="${TG_API_NAME:-nocturne-tg-api}"
WEB_PORT="${WEB_PORT:-8080}"
API_PORT="${API_PORT:-5000}"
WEB_HEALTH_PATH="${WEB_HEALTH_PATH:-/health}"
API_HEALTH_PATH="${API_HEALTH_PATH:-/health}"     # liveness; /api/health is readiness
HC_INTERVAL="${HC_INTERVAL:-10}"
HC_TIMEOUT="${HC_TIMEOUT:-5}"
HC_HEALTHY="${HC_HEALTHY:-2}"
HC_UNHEALTHY="${HC_UNHEALTHY:-2}"
DEREG_DELAY="${DEREG_DELAY:-30}"
API_RULE_PRIORITY="${API_RULE_PRIORITY:-10}"
ACM_CERT_ARN="${ACM_CERT_ARN:-}"   # optional: enables HTTPS :443 + HTTP->HTTPS redirect

# ---- compute (section 3 + 9) --------------------------------------------------
LT_NAME="${LT_NAME:-nocturne-lt}"
INSTANCE_NAME="${INSTANCE_NAME:-nocturne-app}"
INSTANCE_TYPE="${INSTANCE_TYPE:-t3.micro}"
ROOT_VOLUME_GB="${ROOT_VOLUME_GB:-8}"
AMI_SSM_PARAM="${AMI_SSM_PARAM:-/aws/service/ami-amazon-linux-latest/al2023-ami-kernel-default-x86_64}"
ASG_NAME="${ASG_NAME:-nocturne-asg}"
ASG_MIN="${ASG_MIN:-2}"
ASG_MAX="${ASG_MAX:-4}"
ASG_DESIRED="${ASG_DESIRED:-2}"
ASG_HEALTH_GRACE="${ASG_HEALTH_GRACE:-120}"
INSTANCE_WARMUP="${INSTANCE_WARMUP:-120}"
REFRESH_MIN_HEALTHY="${REFRESH_MIN_HEALTHY:-50}"
SCALING_METRIC="${SCALING_METRIC:-cpu}"           # cpu | requests
CPU_TARGET="${CPU_TARGET:-50}"
REQUESTS_PER_TARGET="${REQUESTS_PER_TARGET:-500}" # ALB requests / target / minute
SCALING_POLICY_NAME="${SCALING_POLICY_NAME:-nocturne-target-tracking}"
COMPOSE_VERSION="${COMPOSE_VERSION:-v2.32.4}"     # docker compose plugin on the hosts

# ---- observability -------------------------------------------------------------
LOG_RETENTION_DAYS="${LOG_RETENTION_DAYS:-14}"
LOG_GROUP_CONTAINERS="${LOG_GROUP_CONTAINERS:-/nocturne/prod/containers}"
LOG_GROUP_BOOTSTRAP="${LOG_GROUP_BOOTSTRAP:-/nocturne/prod/bootstrap}"
DASHBOARD_NAME="${DASHBOARD_NAME:-nocturne-prod}"
CW_NAMESPACE_APP="${CW_NAMESPACE_APP:-Nocturne}"
ALARM_5XX_RATE_PCT="${ALARM_5XX_RATE_PCT:-5}"     # % of requests over 5 min
ALARM_CPU_PCT="${ALARM_CPU_PCT:-80}"
