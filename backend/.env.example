# Nocturne Library backend - environment variables
# Copy to backend/.env.local (used by docker compose) or backend/.env (used by
# `npm start` outside Docker) and fill in real values. NEVER commit real values.

# --- Server -----------------------------------------------------------------
# Port the API listens on (the Docker image and compose expect 5000)
PORT=5000
# development | production
NODE_ENV=development
# Comma-separated list of browser origins allowed by CORS.
# Not needed when the SPA and API share an origin (nginx / ALB path routing),
# but list the public site URL anyway, e.g. https://library.example.com
CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# --- Database ---------------------------------------------------------------
# Local compose MongoDB:   mongodb://mongo:27017/nocturnelibrary
# Local Mongo outside Docker: mongodb://127.0.0.1:27017/nocturnelibrary
# Atlas: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/nocturnelibrary?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/nocturnelibrary

# --- Auth -------------------------------------------------------------------
# Long random string used to sign JWTs. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=replace-with-a-long-random-string

# --- Email (nodemailer, Gmail) ----------------------------------------------
# Sender account and an app password (not the account password).
EMAIL_USER=your-address@example.com
EMAIL_PASS=your-app-password

# --- Optional ---------------------------------------------------------------
# Google Books API key; raises quota for book search. Leave empty to omit.
GOOGLE_BOOKS_API_KEY=
