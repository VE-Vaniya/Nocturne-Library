# Non-secret defaults for `docker compose up` (local development only).
# Override any of these - and add EMAIL_USER / EMAIL_PASS / GOOGLE_BOOKS_API_KEY -
# in backend/.env.local (git-ignored), which compose loads after this file.
# Production (docker-compose.prod.yml) does NOT use this file.
MONGODB_URI=mongodb://mongo:27017/nocturnelibrary
JWT_SECRET=local-dev-only-insecure-jwt-secret-do-not-use-in-prod
CORS_ORIGINS=http://localhost:8080,http://localhost:5173
EMAIL_USER=
EMAIL_PASS=
GOOGLE_BOOKS_API_KEY=
